set shell := ["bash", "-c"]

# Create and start a single-node k3s server
create name="k3s-server":
    limactl start --name {{ name }} template:k3s

# Start an existing server VM
up name="k3s-server":
    limactl start {{ name }}

# Open a shell in a VM
shell name:
    limactl shell {{ name }}

# Run kubectl via the server node
kubectl name="k3s-server" *args="":
    limactl shell {{ name }} -- kubectl {{ args }}

# Export kubeconfig to a local file
kubeconfig name="k3s-server":
    @echo "$(limactl list {{ name }} --format '{{{{.Dir}}/copied-from-guest/kubeconfig.yaml')"

# Stop a VM
stop name="k3s-server":
    limactl stop {{ name }}

# Tear down and remove a VM completely
down name:
    limactl stop {{ name }} || true
    limactl delete {{ name }}

# List all Lima VMs
list:
    limactl list
